# Public — safe in the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only — NEVER prefix with NEXT_PUBLIC_ and never import into client code.
# Only needed for admin tasks (inviting users). The inventory module does not use it.
SUPABASE_SERVICE_ROLE_KEY=
