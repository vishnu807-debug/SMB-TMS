# ---------------------------------------------------------------------------
# Public — safe in the browser (all data access is protected by Row Level Security).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# The address people use to open the app (used in password-reset and invite links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server only — NEVER prefix with NEXT_PUBLIC_ and never import into client code.
# ---------------------------------------------------------------------------
# Needed for: inviting users, sign-in lock-out, scheduled jobs and e-invoice dispatch.
SUPABASE_SERVICE_ROLE_KEY=
# Random string (32+ characters). Vercel Cron sends it to /api/cron/*.  e.g. `openssl rand -hex 32`
CRON_SECRET=

# UAE e-invoicing — credentials from your FTA-accredited service provider (ASP). Leave empty until onboarded.
EINVOICE_ASP_URL=
EINVOICE_ASP_API_KEY=
EINVOICE_ASP_NAME=
